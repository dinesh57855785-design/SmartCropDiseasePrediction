    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_water",
      "top": 200,
      "left": 160,
      "attrs": { "label": "Water Tank Level (%)", "value": "3000" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": -150,
      "left": -180,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_pump",
      "top": -70,
      "left": -260,
      "attrs": { "color": "green", "label": "PUMP ACTIVE" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -20,
      "left": -230,
      "attrs": { "value": "220" }
    }

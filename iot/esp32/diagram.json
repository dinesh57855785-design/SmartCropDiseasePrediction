{
  "version": 1,
  "author": "SmartCropDiseasePrediction",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -140,
      "left": 130,
      "attrs": { "temperature": "28.5", "humidity": "65" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_soil",
      "top": 200,
      "left": -160,

  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "dht1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "dht1:GND", "black", [ "v0" ] ],
    [ "esp:15", "dht1:SDA", "gold", [ "v0" ] ],

    [ "esp:3V3", "pot_soil:VCC", "red", [ "h0" ] ],
    [ "esp:GND.2", "pot_soil:GND", "black", [ "h0" ] ],
    [ "esp:34", "pot_soil:SIG", "orange", [ "h0" ] ],

    [ "esp:3V3", "pot_water:VCC", "red", [ "h0" ] ],
    [ "esp:GND.2", "pot_water:GND", "black", [ "h0" ] ],
    [ "esp:35", "pot_water:SIG", "blue", [ "h0" ] ],

    [ "esp:5V", "relay1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "relay1:GND", "black", [ "v0" ] ],
    [ "esp:19", "relay1:IN", "purple", [ "v0" ] ],

    [ "esp:18", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led_pump:A", "green", [ "v0" ] ],
    [ "esp:GND.1", "led_pump:C", "black", [ "v0" ] ]
